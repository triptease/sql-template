#!/usr/bin/env bash
# Thin entrypoint: tool versions live in mise.toml, tasks in package.json.
set -Eeuo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
cd "${dir}"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required (it installs the pinned node and bun from mise.toml)." >&2
  echo "Install it from https://mise.jdx.dev/getting-started.html then re-run ./run" >&2
  exit 1
fi

mise install --quiet

function bun() {
  mise exec -- bun "$@"
}

function install() {
  if [ "${CI:-}" = "true" ]; then
    bun install --frozen-lockfile
  else
    bun install
  fi
}

function clean() {
  bun run clean
}

function build() {
  install
  clean
  bun run build
  bun run typecheck
  bun run test
}

function test() {
  bun run test "$@"
}

function ci() {
  build
}

command="${1-build}"
[ $# -gt 0 ] && shift
"${command}" "$@"
